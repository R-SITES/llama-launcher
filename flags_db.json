{
  "core": [
    {
      "flag": "-m",
      "full": "--model",
      "type": "path",
      "hint": "FNAME",
      "help": "Path to the model file",
      "default": "",
      "required": false
    },
    {
      "flag": "-hf",
      "full": "--hf-repo",
      "type": "text",
      "hint": "user/model[:quant]",
      "help": "Hugging Face model repo (replaces -m for cached/models with MTP). Example: unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-Q4_K_M",
      "default": ""
    },
    {
      "flag": "-c",
      "full": "--ctx-size",
      "type": "int",
      "hint": "N",
      "help": "Context size in tokens",
      "default": "4096"
    },
    {
      "flag": "-ngl",
      "full": "--gpu-layers",
      "type": "int",
      "hint": "N",
      "help": "Number of layers to offload to GPU (use 'all' for all layers)",
      "default": "99"
    },
    {
      "flag": "-b",
      "full": "--batch-size",
      "type": "int",
      "hint": "N",
      "help": "Batch size for prompt processing",
      "default": "512"
    },
    {
      "flag": "-ub",
      "full": "--ubatch-size",
      "type": "int",
      "hint": "N",
      "help": "Micro-batch size (ubatch)",
      "default": "512"
    },
    {
      "flag": "-np",
      "full": "--parallel",
      "type": "int",
      "hint": "N",
      "help": "Number of server slots (server-side parallel prompt processing)",
      "default": "4"
    },
    {
      "flag": "-t",
      "full": "--threads",
      "type": "int",
      "hint": "N",
      "help": "Number of threads for generation",
      "default": "8"
    },
    {
      "flag": "-tb",
      "full": "--threads-batch",
      "type": "int",
      "hint": "N",
      "help": "Number of threads for batch processing",
      "default": "8"
    },
    {
      "flag": "--reasoning",
      "type": "select",
      "options": [
        "on",
        "off",
        "auto"
      ],
      "default": "on",
      "hint": "on|off|auto",
      "help": "Reasoning/thinking mode [on|off|auto]"
    },
    {
      "flag": "--reasoning-preserve",
      "type": "bool",
      "default": "true",
      "hint": "",
      "help": "Preserve reasoning/thinking content in chat output (instead of stripping it)"
    },
    {
      "flag": "--port",
      "type": "int",
      "hint": "N",
      "help": "HTTP server port",
      "default": "8080"
    },
    {
      "flag": "--host",
      "type": "string",
      "hint": "HOST",
      "help": "Bind host address",
      "default": "127.0.0.1"
    },
    {
      "flag": "--verbose",
      "type": "bool",
      "help": "Verbose output",
      "default": false
    },
    {
      "flag": "--no-mmproj",
      "type": "bool",
      "help": "Disable multimodal projector (mmproj) \u2014 prevents loading vision encoder even if mmproj file is present"
    },
    {
      "flag": "--chat-template-file",
      "type": "path",
      "hint": "FNAME",
      "help": "Path to a chat template .jinja file (e.g. ~/models/chat_template-v15.jinja)"
    },
    {
      "flag": "--alias",
      "type": "string",
      "hint": "NAME",
      "help": "Short display name for the model (replaces full path in UI)",
      "default": ""
    },
    {
      "flag": "--cache-type-k",
      "type": "select",
      "options": [
        "f32",
        "f16",
        "bf16",
        "q8_0",
        "q4_0",
        "q4_1",
        "iq4_nl",
        "q5_0",
        "q5_1"
      ],
      "help": "KV cache data type for K (quantize to save VRAM)",
      "default": "q8_0"
    },
    {
      "flag": "--cache-type-v",
      "type": "select",
      "options": [
        "f32",
        "f16",
        "bf16",
        "q8_0",
        "q4_0",
        "q4_1",
        "iq4_nl",
        "q5_0",
        "q5_1"
      ],
      "help": "KV cache data type for V (quantize to save VRAM)",
      "default": "q8_0"
    },
    {
      "flag": "--slot-save-path",
      "type": "path",
      "hint": "PATH",
      "help": "Path to save slot KV cache files (persists context across restarts)",
      "default": ""
    }
  ],
  "sampling": [
    {
      "flag": "--temp",
      "type": "float",
      "hint": "N",
      "help": "Sampling temperature (0.0 = greedy, higher = more random)",
      "default": "0.5"
    },
    {
      "flag": "--top-k",
      "type": "int",
      "hint": "N",
      "help": "Top-K sampling: restrict to top K tokens (0 = disabled)",
      "default": "40"
    },
    {
      "flag": "--top-p",
      "type": "float",
      "hint": "N",
      "help": "Top-p (nucleus) sampling: cumulative probability threshold (0.0 = disabled)",
      "default": "0.9"
    },
    {
      "flag": "--min-p",
      "type": "float",
      "hint": "N",
      "help": "Min-p sampling: minimum probability threshold (0.0 = disabled)",
      "default": "0.05"
    },
    {
      "flag": "--repeat-penalty",
      "type": "float",
      "hint": "N",
      "help": "Repeat penalty for consecutive tokens (1.0 = disabled)",
      "default": "1.1"
    },
    {
      "flag": "--repeat-last-n",
      "type": "int",
      "hint": "N",
      "help": "Last N tokens to consider for repeat penalty (0 = disabled, -1 = ctx_size)",
      "default": "64"
    },
    {
      "flag": "--presence-penalty",
      "type": "float",
      "hint": "N",
      "help": "Presence penalty: penalize tokens based on whether they appear (0.0 = disabled)",
      "default": "0.0"
    },
    {
      "flag": "--frequency-penalty",
      "type": "float",
      "hint": "N",
      "help": "Frequency penalty: penalize tokens based on frequency (0.0 = disabled)",
      "default": "0.0"
    },
    {
      "flag": "--typical-p",
      "type": "float",
      "hint": "N",
      "help": "Locally typical sampling parameter p (1.0 = disabled)",
      "default": "1.0"
    },
    {
      "flag": "--mirostat",
      "type": "int",
      "hint": "N",
      "help": "Mirostat sampling mode (0 = disabled, 1 = Mirostat, 2 = Mirostat 2.0)",
      "default": "0"
    },
    {
      "flag": "--mirostat-lr",
      "type": "float",
      "hint": "N",
      "help": "Mirostat learning rate (eta)",
      "default": "0.1"
    },
    {
      "flag": "--mirostat-ent",
      "type": "float",
      "hint": "N",
      "help": "Mirostat target entropy (tau)",
      "default": "5.0"
    },
    {
      "flag": "--xtc-probability",
      "type": "float",
      "hint": "N",
      "help": "XTC probability threshold (0.0 = disabled)",
      "default": "0.0"
    },
    {
      "flag": "--xtc-threshold",
      "type": "float",
      "hint": "N",
      "help": "XTC threshold (1.0 = disabled)",
      "default": "0.1"
    },
    {
      "flag": "--dry-multiplier",
      "type": "float",
      "hint": "N",
      "help": "DRY sampling multiplier (0.0 = disabled)",
      "default": "0.0"
    },
    {
      "flag": "--dry-base",
      "type": "float",
      "hint": "N",
      "help": "DRY sampling base value",
      "default": "1.1"
    },
    {
      "flag": "--dry-allowed-length",
      "type": "int",
      "hint": "N",
      "help": "DRY allowed length for repeated sequences",
      "default": "2"
    },
    {
      "flag": "--dry-penalty-last-n",
      "type": "int",
      "hint": "N",
      "help": "DRY penalty last N tokens (0 = disabled, -1 = ctx_size)",
      "default": "-1"
    },
    {
      "flag": "--top-nsigma",
      "type": "float",
      "hint": "N",
      "help": "Top-n-sigma sampling parameter (-1.0 = disabled)",
      "default": "-1.0"
    },
    {
      "flag": "--dynatemp-range",
      "type": "float",
      "hint": "N",
      "help": "Dynamic temperature range (0.0 = disabled)",
      "default": "0.0"
    },
    {
      "flag": "--dynatemp-exp",
      "type": "float",
      "hint": "N",
      "help": "Dynamic temperature exponent",
      "default": "1.0"
    },
    {
      "flag": "--adaptive-target",
      "type": "float",
      "hint": "N",
      "help": "Adaptive-p: select tokens near this probability (0.0 to 1.0)",
      "default": "0.0"
    },
    {
      "flag": "--adaptive-decay",
      "type": "float",
      "hint": "N",
      "help": "Adaptive-p: decay rate for target adaptation (0.0 to 0.99)",
      "default": "0.99"
    },
    {
      "flag": "--grammar",
      "type": "string",
      "hint": "GRAMMAR",
      "help": "BNF-like grammar to constrain generations"
    },
    {
      "flag": "--grammar-file",
      "type": "path",
      "hint": "FNAME",
      "help": "File to read grammar from"
    },
    {
      "flag": "-s",
      "full": "--seed",
      "type": "int",
      "hint": "SEED",
      "help": "RNG seed (use random seed for -1)"
    }
  ],
